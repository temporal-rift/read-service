<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

  <!-- Size player_name to the session-event GameStartedPlayer.playerName bound (min 1, max 32, session-event 4.0.0),
       so every contract-valid GameStarted roster projects without truncation or dead-letter. -->
  <changeSet id="022-size-game-player-name-to-contract-bound" author="read-service">
    <modifyDataType tableName="game_player" columnName="player_name" newDataType="VARCHAR(32)"/>
  </changeSet>

</databaseChangeLog>
