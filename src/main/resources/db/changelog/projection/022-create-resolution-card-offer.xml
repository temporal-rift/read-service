<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
  <changeSet id="022-create-resolution-card-offer" author="read-service">
    <createTable tableName="resolution_card_offer">
      <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
      <column name="game_id" type="UUID"><constraints nullable="false"/></column>
      <column name="player_id" type="UUID"><constraints nullable="false"/></column>
      <column name="era_number" type="INT"><constraints nullable="false"/></column>
      <column name="cards" type="JSONB"><constraints nullable="false"/></column>
    </createTable>
    <addUniqueConstraint tableName="resolution_card_offer"
        columnNames="game_id, player_id, era_number" constraintName="uq_resolution_card_offer_identity"/>
  </changeSet>
</databaseChangeLog>
