<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

  <!-- Every normal-victory condition the winner met, comma-joined in published order; null when absent. -->
  <changeSet id="029-add-win-conditions-to-terminal-winner" author="read-service">
    <addColumn tableName="game_terminal_winner">
      <column name="win_conditions" type="VARCHAR(64)"/>
    </addColumn>
  </changeSet>

</databaseChangeLog>
