<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

  <!-- One row per game: the current Weaver chain's status and link count, cleared at GameEnded. -->
  <changeSet id="013-create-game-chain-projection" author="read-service">
    <createTable tableName="game_chain_projection">
      <column name="game_id" type="UUID">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="chain_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="status" type="VARCHAR(16)">
        <constraints nullable="false"/>
      </column>
      <column name="length" type="INT">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>

</databaseChangeLog>
