<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
  <changeSet id="023-expand-participant-projection" author="read-service">
    <addColumn tableName="game_projection">
      <column name="win_score_threshold" type="INT"/>
    </addColumn>
    <createTable tableName="game_projection_affected_event">
      <column name="game_projection_id" type="UUID"><constraints nullable="false"/></column>
      <column name="event_id" type="UUID"><constraints nullable="false"/></column>
    </createTable>
    <addForeignKeyConstraint baseTableName="game_projection_affected_event"
        baseColumnNames="game_projection_id" referencedTableName="game_projection"
        referencedColumnNames="game_id" constraintName="fk_game_projection_affected_event_game_projection"
        onDelete="CASCADE"/>
  </changeSet>
</databaseChangeLog>
