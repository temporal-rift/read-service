<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

  <!-- Game-scoped state shared by every player of a game — design.md Decision 1. -->
  <changeSet id="001-create-game-projection" author="read-service">
    <createTable tableName="game_projection">
      <column name="game_id" type="UUID">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="era_number" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="phase" type="VARCHAR(20)">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <createTable tableName="game_projection_pending_paradox">
      <column name="game_projection_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="paradox_id" type="UUID">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addForeignKeyConstraint
        baseTableName="game_projection_pending_paradox"
        baseColumnNames="game_projection_id"
        referencedTableName="game_projection"
        referencedColumnNames="game_id"
        constraintName="fk_game_projection_pending_paradox_game_projection"
        onDelete="CASCADE"/>
  </changeSet>

</databaseChangeLog>
