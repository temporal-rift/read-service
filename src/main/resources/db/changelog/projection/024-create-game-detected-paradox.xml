<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
  <changeSet id="024-create-game-detected-paradox" author="read-service">
    <createTable tableName="game_detected_paradox">
      <column name="paradox_id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
      <column name="game_id" type="UUID"><constraints nullable="false"/></column>
      <column name="era_number" type="INT"><constraints nullable="false"/></column>
      <column name="type" type="VARCHAR(32)"><constraints nullable="false"/></column>
      <column name="affected_event_id" type="UUID"><constraints nullable="false"/></column>
      <column name="affected_outcome_ids" type="JSONB"><constraints nullable="false"/></column>
    </createTable>
    <createIndex tableName="game_detected_paradox" indexName="idx_game_detected_paradox_game_era">
      <column name="game_id"/>
      <column name="era_number"/>
    </createIndex>
  </changeSet>
</databaseChangeLog>
