<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

  <changeSet id="006-add-hand-selection-state" author="read-service">
    <createTable tableName="player_game_state_pending_hand_card">
      <column name="player_game_state_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="card_position" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="card_instance_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="card_type" type="VARCHAR(30)">
        <constraints nullable="false"/>
      </column>
      <column name="grade" type="VARCHAR(3)">
        <constraints nullable="false"/>
      </column>
      <column name="deal_slot" type="INT">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addForeignKeyConstraint
        baseTableName="player_game_state_pending_hand_card"
        baseColumnNames="player_game_state_id"
        referencedTableName="player_game_state"
        referencedColumnNames="id"
        constraintName="fk_player_game_state_pending_hand_card_player_game_state"
        onDelete="CASCADE"/>
  </changeSet>
</databaseChangeLog>
