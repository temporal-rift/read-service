<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.temporal-rift</groupId>
        <artifactId>temporal-rift-bom</artifactId>
        <version>1.10.0</version>
        <relativePath/>
    </parent>

    <artifactId>read-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Temporal Rift Read Service</name>
    <description>Temporal Rift read-side projection and notification service</description>
    <url/>

    <licenses>
        <license>
            <name>GNU General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>kronen</id>
            <name>Alberto Gonzalez Lagos</name>
            <email>kronenr@gmail.com</email>
            <url>https://github.com/kronen</url>
            <roles>
                <role>architect</role>
                <role>developer</role>
            </roles>
            <timezone>Europe/Madrid</timezone>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git@github.com:temporal-rift/read-service.git</connection>
        <developerConnection>scm:git:git@github.com:temporal-rift/read-service.git</developerConnection>
        <url>https://github.com/temporal-rift/read-service</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <sonar.organization>temporal-rift</sonar.organization>
        <sonar.projectKey>temporal-rift_read-service</sonar.projectKey>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>
        <sonar.exclusions>**/generated-sources/**/*</sonar.exclusions>
        <sonar.coverage.exclusions>**/generated-sources/**/*</sonar.coverage.exclusions>

        <archunit-junit5.version>1.4.2</archunit-junit5.version>
        <projection-api.version>2.5.0</projection-api.version>
        <session-event.version>1.2.1</session-event.version>
        <action-event.version>1.3.0</action-event.version>
        <scoring-event.version>1.0.1</scoring-event.version>
        <timeline-event.version>1.0.5</timeline-event.version>
    </properties>

    <dependencies>
        <!-- Spec-only: bundles projection-api's OpenAPI specification. Codegen for it is driven by the
             openapi-generator-maven-plugin execution below. -->
        <dependency>
            <groupId>io.github.temporal-rift</groupId>
            <artifactId>projection-api</artifactId>
            <version>${projection-api.version}</version>
        </dependency>
        <!-- Spec-only: bundles session-event's asyncapi.yml, no compiled code. Consumed for the session-owned
             game.events facts GameEventsKafkaConsumer and GameHistoryKafkaConsumer project, which this service
             reads but does not produce. -->
        <dependency>
            <groupId>io.github.temporal-rift</groupId>
            <artifactId>session-event</artifactId>
            <version>${session-event.version}</version>
        </dependency>
        <!-- Spec-only: bundles action-event's asyncapi.yml, no compiled code. Consumed for ActionRoundStarted
             and CardPlayed, which this service reads from game.events but does not produce. -->
        <dependency>
            <groupId>io.github.temporal-rift</groupId>
            <artifactId>action-event</artifactId>
            <version>${action-event.version}</version>
        </dependency>
        <!-- Spec-only: bundles scoring-event's asyncapi.yml, no compiled code. Consumed for ScoresUpdated,
             which this service reads from game.events but does not produce. -->
        <dependency>
            <groupId>io.github.temporal-rift</groupId>
            <artifactId>scoring-event</artifactId>
            <version>${scoring-event.version}</version>
        </dependency>
        <!-- Spec-only: bundles timeline-event's asyncapi.yml, no compiled code. Consumed for the resolution
             facts TimelineEventsKafkaConsumer and GameHistoryKafkaConsumer project from timeline.events, which
             this service reads but does not produce. -->
        <dependency>
            <groupId>io.github.temporal-rift</groupId>
            <artifactId>timeline-event</artifactId>
            <version>${timeline-event.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-zipkin</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-liquibase</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-insight</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit-junit5.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <configuration>
                    <importMappings>
                        <importMapping>ProblemDetail=org.springframework.http.ProblemDetail</importMapping>
                    </importMappings>
                </configuration>
                <executions>
                    <execution>
                        <id>generate-projection-api</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>
                                ${project.build.directory}/dependency-specs/projection-api-${projection-api.version}-jar/openapi/v1/projection.yml
                            </inputSpec>
                            <output>${project.build.directory}/generated-sources/openapi/projection</output>
                            <apiPackage>
                                io.github.temporalrift.read.projection.infrastructure.adapter.in.rest.v1
                            </apiPackage>
                            <modelPackage>
                                io.github.temporalrift.read.projection.infrastructure.adapter.in.rest.v1.model
                            </modelPackage>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- BOM 1.5.1 configures the compiler output directory globally. Keep test compilation
                 separate so its incremental cleanup cannot remove generated main classes. -->
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <outputDirectory>${project.build.testOutputDirectory}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>add-openapi-generated-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>
                                    ${project.build.directory}/generated-sources/openapi/projection/src/main/java
                                </source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
